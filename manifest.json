{
  "name": "AliExpress Delivery Switcher",
  "manifest_version": 3,
  "version": "1.1.1",
  "description": "1-click delivery country, currency & language switcher for AliExpress with anti-RU redirect protection.",
  "permissions": [
    "tabs",
    "storage",
    "cookies",
    "webNavigation"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "*://*.aliexpress.com/*",
    "*://*.aliexpress.ru/*",
    "*://*.aliexpress.us/*"
  ],
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.aliexpress.com/*",
        "*://aliexpress.com/*",
        "*://*.aliexpress.ru/*",
        "*://aliexpress.ru/*",
        "*://*.aliexpress.us/*",
        "*://aliexpress.us/*"
      ],
      "exclude_matches": [
        "*://checkout.aliexpress.com/*",
        "*://trade.aliexpress.com/*",
        "*://pay.aliexpress.com/*",
        "*://payment.aliexpress.com/*",
        "*://cashier.aliexpress.com/*",
        "*://*.alipay.com/*"
      ],
      "css": [
        "css/content.css"
      ],
      "js": [
        "js/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "*://*.aliexpress.com/*",
        "*://aliexpress.com/*",
        "*://*.aliexpress.ru/*",
        "*://aliexpress.ru/*",
        "*://*.aliexpress.us/*",
        "*://aliexpress.us/*"
      ]
    }
  ]
}